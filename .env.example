# Plantilla de llaves para Hermes Agent.
# Cópiala a ~/.hermes/.env y llena los valores.
# NUNCA subas el .env real a git.

# --- Modelos (fase 1) ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- WhatsApp (fase 2) ---
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot                 # "bot" (número aparte) o "self-chat" (tu número, para probar)
WHATSAPP_ALLOWED_USERS=           # solo tu número: con lada, sin "+", p. ej. 52133XXXXXXXX

# --- Voz, opcionales (fase 2) ---
# Sin llaves se usa whisper local para escuchar y Edge TTS para hablar.
# GROQ_API_KEY=                   # transcripción en la nube (Groq Whisper)
# ELEVENLABS_API_KEY=             # voz premium
